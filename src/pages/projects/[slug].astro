---
import Layout from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getAllProjects, getProjectBySlug } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://portofolio.dev';
---

<Layout title={project.title}>
  <Nav />
  <main class="pt-20 min-h-screen">
    <article class="container mx-auto px-4 py-20 max-w-4xl">
      <nav class="mb-8 text-sm" style="color: var(--fg); opacity: 0.6;">
        <a href="/" style="color: var(--acc);">Home</a>
        <span class="mx-2">/</span>
        <a href="/projects" style="color: var(--acc);">Projects</a>
        <span class="mx-2">/</span>
        <span>{project.title}</span>
      </nav>

      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--fg);">
          {project.title}
        </h1>

        <div class="flex flex-wrap gap-2 mb-6">
          {project.stack.split(',').map(tech => (
            <span
              class="text-sm px-3 py-1 rounded"
              style="background: var(--acc); color: var(--bg);"
            >
              {tech.trim()}
            </span>
          ))}
        </div>

        <div class="flex gap-4">
          {project.github_url && (
            <a
              href={project.github_url}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded text-sm"
              style="background: var(--card-bg); border: 1px solid var(--card-border); color: var(--fg);"
            >
              GitHub →
            </a>
          )}
          {project.live_url && (
            <a
              href={project.live_url}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded text-sm"
              style="background: var(--acc); color: var(--bg);"
            >
              Live Demo →
            </a>
          )}
        </div>
      </header>

      {project.image_url && (
        <div class="mb-12">
          <img
            src={project.image_url}
            alt={project.title}
            class="w-full rounded-lg"
            loading="lazy"
          />
        </div>
      )}

      <div class="prose" style="color: var(--fg);">
        <p class="text-lg leading-relaxed">{project.description}</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-12 p-6 rounded-lg"
           style="background: var(--card-bg); border: 1px solid var(--card-border);">
        <div>
          <div class="text-sm opacity-60 mb-1">Category</div>
          <div class="font-semibold">{project.category}</div>
        </div>
        <div>
          <div class="text-sm opacity-60 mb-1">Year</div>
          <div class="font-semibold">{project.year}</div>
        </div>
        <div>
          <div class="text-sm opacity-60 mb-1">Stack</div>
          <div class="font-semibold">{project.stack.split(',').length} technologies</div>
        </div>
        <div>
          <div class="text-sm opacity-60 mb-1">Status</div>
          <div class="font-semibold">{project.live_url ? 'Live' : 'Completed'}</div>
        </div>
      </div>

      <div class="mt-12">
        <a href="/projects" style="color: var(--acc);">
          ← Back to Projects
        </a>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
