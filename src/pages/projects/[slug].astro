---
import PageHead from '../../layouts/PageHead.astro';
import Header from '../../components/Header.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const hasUi = data.has_ui !== false;
const imgSrc = data.image_url || '/images/placeholder.svg';
const stackItems = data.stack.split(',').map((t: string) => t.trim());
---

<PageHead lang="en" title={`${data.title} — Case Study`} description={data.description} themeDefault="gallery">
  <Header />
  <main id="top">
    <section id="project-detail">
      <div class="wrap">

        <nav class="section-head">
          <a href="/" class="section-link">Home</a>
          <span class="rule"></span>
          <a href="/projects" class="section-link">Projects</a>
          <span class="rule"></span>
          <span class="mono code">{data.title}</span>
        </nav>

        {hasUi ? (
          <div class="proj-hero" data-reveal>
            <img src={imgSrc} alt={data.title} loading="lazy" />
          </div>
        ) : (
          <div class="proj-terminal" data-reveal>
            <div class="terminal-bar">
              <span class="terminal-dot red"></span>
              <span class="terminal-dot yellow"></span>
              <span class="terminal-dot green"></span>
              <span class="terminal-title mono">{data.slug}</span>
            </div>
            <div class="terminal-body">
              <div class="terminal-line"><span class="t-prompt">$</span> <span class="t-cmd">cat</span> README.md</div>
              <div class="terminal-line t-comment"># {data.title}</div>
              <div class="terminal-line t-dim">{data.description}</div>
              <div class="terminal-line"></div>
              <div class="terminal-line"><span class="t-prompt">$</span> <span class="t-cmd">tree</span> --dirsfirst -L 2</div>
              <div class="terminal-line t-dim">.</div>
              <div class="terminal-line t-dim">├── src/</div>
              <div class="terminal-line t-dim">│   ├── controllers/</div>
              <div class="terminal-line t-dim">│   ├── services/</div>
              <div class="terminal-line t-dim">│   ├── models/</div>
              <div class="terminal-line t-dim">│   └── middleware/</div>
              <div class="terminal-line t-dim">├── prisma/</div>
              <div class="terminal-line t-dim">├── docker-compose.yml</div>
              <div class="terminal-line t-dim">└── package.json</div>
              <div class="terminal-line"></div>
              <div class="terminal-line"><span class="t-prompt">$</span> <span class="t-cmd">docker</span> compose ps</div>
              {stackItems.map((s: string) => (
                <div class="terminal-line t-stack"><span class="t-check">✓</span> {s}</div>
              ))}
            </div>
          </div>
        )}

        <div class="proj-meta" data-reveal>
          <div class="proj-meta-cell">
            <div class="label">Category</div>
            <div class="value">{data.category}</div>
          </div>
          <div class="proj-meta-cell">
            <div class="label">Year</div>
            <div class="value">{data.year}</div>
          </div>
          <div class="proj-meta-cell">
            <div class="label">Stack</div>
            <div class="value">{stackItems.length} technologies</div>
          </div>
        </div>

        <h1 class="proj-title" data-reveal>{data.title}</h1>

        <div class="proj-tags" data-reveal>
          {stackItems.map((t: string) => (
            <span>{t}</span>
          ))}
        </div>

        <div class="proj-cta" data-reveal>
          {data.github_url && (
            <a href={data.github_url} target="_blank" rel="noopener" class="btn ghost">GitHub ↗</a>
          )}
          {data.live_url && (
            <a href={data.live_url} target="_blank" rel="noopener" class="btn solid">Live Demo ↗</a>
          )}
        </div>

        <div class="proj-content prose" data-reveal>
          <Content />
        </div>

        {hasUi && data.images && data.images.length > 1 && (
          <div class="proj-gallery" data-reveal>
            <h2 class="proj-section-title">Screenshots</h2>
            <div class="proj-gallery-grid">
              {data.images.map((img: string, i: number) => (
                <figure class="proj-gallery-item">
                  <img src={img} alt={`${data.title} screenshot ${i + 1}`} loading="lazy" />
                </figure>
              ))}
            </div>
          </div>
        )}

        <div class="proj-back" data-reveal>
          <a href="/projects" class="arrow-link"><i>→</i><b>View All Projects</b></a>
        </div>
      </div>
    </section>
  </main>
  <ContactFooter />
</PageHead>
