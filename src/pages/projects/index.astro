---
import PageHead from '../../layouts/PageHead.astro';
import Header from '../../components/Header.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<PageHead lang="en" title="Projects — Raihan Achmad" description="All projects by Raihan Achmad" themeDefault="gallery">
  <Header />
  <main id="top">
    <section id="projects">
      <div class="wrap">
        <div class="section-head">
          <h2 class="section-title">All Projects</h2>
        </div>

        <div class="works-grid">
          <aside class="works-side">
            <p>A collection of projects I've built across different technologies.</p>
            <nav class="works-index" aria-label="Project navigation">
              {projects.map((pr) => (
                <a href={`/projects/${pr.id}`}><i>/{String(pr.data.order).padStart(2, '0')}</i><b>{pr.data.title}</b></a>
              ))}
            </nav>
          </aside>
          <div>
            {projects.map((pr) => (
              <article class="proj" data-reveal>
                <div class="proj-top mono"><span class="no">/{String(pr.data.order).padStart(2, '0')}</span><span>{pr.data.year} · {pr.data.category}</span></div>
                <figure>
                  <img src={pr.data.image_url || '/images/placeholder.svg'} alt={pr.data.title} loading="lazy" />
                </figure>
                <h3>{pr.data.title}</h3>
                <p class="desc">{pr.data.description}</p>
                <div class="tags">
                  {pr.data.stack.split(',').map((t: string) => <span>{t.trim()}</span>)}
                </div>
                <a href={`/projects/${pr.id}`} class="arrow-link">View Details<i>→</i></a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
  <ContactFooter />
</PageHead>
