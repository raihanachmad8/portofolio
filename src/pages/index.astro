---
import PageHead from '../layouts/PageHead.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Works from '../components/Works.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Blog from '../components/Blog.astro';
import ContactFooter from '../components/ContactFooter.astro';
import NewsTicker from '../components/NewsTicker.astro';
import { getProfile } from '../lib/content';

const profile = await getProfile();
---

<PageHead lang="en" title={`${profile.name} — ${profile.roleTitle}`} description={profile.heroSub} themeDefault="gallery">
  <NewsTicker />
  <Header />
  <main id="top">
    <Hero name={profile.name} tagline={profile.roleTitle} subtitle={profile.heroSub} location={profile.location} marquee={profile.marquee} />
    <Works />
    <About />
    <Skills />
    <Experience />
    <Blog />
  </main>
  <ContactFooter />
</PageHead>
