---
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import ContactFooter from '@components/ContactFooter.astro';
import { getPostBySlug, getProfile } from '@lib/content';
import { formatDate, getRuntimeEnv, SITE_URL, OG_DEFAULT_IMAGE } from '@lib/utils';
import { marked } from 'marked';
import { getLocale } from '@i18n';
import SEO from '@components/SEO.astro';
import { buildBreadcrumbSchema } from '@lib/seo-helpers';

const { slug } = Astro.params;
if (!slug) return new Response('Not found', { status: 404 });
const env = getRuntimeEnv(Astro);
const post = await getPostBySlug(slug, env);
const profile = await getProfile(env);
const { locale, t } = getLocale(Astro);

if (!post) {
  return new Response('Not found', { status: 404 });
}

const contentHtml = marked(post.content || '');
const siteUrl = import.meta.env.PUBLIC_SITE_URL || SITE_URL;
const postUrl = `${siteUrl}/blog/${post.slug}`;

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  image: `${siteUrl}${OG_DEFAULT_IMAGE}`,
  url: postUrl,
  datePublished: post.published_date,
  dateModified: post.published_date,
  author: {
    '@type': 'Person',
    name: t('seo.siteName'),
    url: siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: t('seo.siteName'),
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  wordCount: post.content?.split(/\s+/).length || 0,
  articleSection: post.category,
  keywords: post.tags?.join(', '),
};

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: t('common.home'), url: siteUrl },
  { name: t('blog.title'), url: `${siteUrl}/blog` },
  { name: post.title, url: postUrl },
]);
---

<Base lang={locale} title={`${post.title} — ${t('blog.title')}`} themeDefault="gallery">
  <SEO
    title={`${post.title} — ${t('blog.title')}`}
    description={post.excerpt}
    image={OG_DEFAULT_IMAGE}
    url={postUrl}
    type="article"
    author={t('seo.siteName')}
    publishedTime={post.published_date}
    modifiedTime={post.published_date}
    sameAs={[profile.github, profile.linkedin].filter(Boolean)}
  />
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Header />
  <main id="top">
    <section id="blog-post">
      <div class="wrap">
        <nav class="section-head">
          <a href="/" class="section-link">{t('common.home')}</a>
          <span class="rule"></span>
          <a href="/blog" class="section-link">{t('blog.title')}</a>
          <span class="rule"></span>
          <span class="mono code">{post.title}</span>
        </nav>

        <article>
          <div class="blog-post-meta mono">
            <span class="blog-post-category">{post.category}</span>
            <span>{formatDate(post.published_date)}</span>
            <span>{post.read_time} {t('blog.minRead')}</span>
          </div>
          <h1 class="blog-post-title">{post.title}</h1>
          <div class="blog-post-tags mono">
            {post.tags?.map((tag: string) => (
              <span>{tag}</span>
            ))}
          </div>

          <div class="proj-content prose" set:html={contentHtml} />

          <div class="proj-back">
            <a href="/blog" class="arrow-link"><i>→</i><b>{t('blog.allPosts')}</b></a>
          </div>
        </article>
      </div>
    </section>
  </main>
  <ContactFooter />
</Base>
