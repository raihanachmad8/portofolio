---
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import ContactFooter from '@components/ContactFooter.astro';
import { getPostBySlug, getProjectContent } from '@lib/content';
import { fmtDate, getRuntimeEnv } from '@lib/utils';
import { marked } from 'marked';

const { slug } = Astro.params;
const env = getRuntimeEnv(Astro);
const post = await getPostBySlug(slug as string, env);

if (!post) {
  return Astro.redirect('/blog');
}

const contentHtml = marked(post.content || '');
---

<Base lang="en" title={`${post.title} — Blog`} description={post.excerpt} themeDefault="gallery">
  <Header />
  <main id="top">
    <section id="blog-post">
      <div class="wrap">
        <nav class="section-head">
          <a href="/" class="section-link">Home</a>
          <span class="rule"></span>
          <a href="/blog" class="section-link">Blog</a>
          <span class="rule"></span>
          <span class="mono code">{post.title}</span>
        </nav>

        <article>
          <div class="blog-post-meta mono">
            <span class="blog-post-category">{post.category}</span>
            <span>{fmtDate(post.published_date)}</span>
            <span>{post.read_time} min read</span>
          </div>
          <h1 class="blog-post-title">{post.title}</h1>
          <div class="blog-post-tags mono">
            {post.tags?.map((tag: string) => (
              <span>{tag}</span>
            ))}
          </div>

          <div class="proj-content prose" set:html={contentHtml} />

          <div class="proj-back">
            <a href="/blog" class="arrow-link"><i>→</i><b>All Posts</b></a>
          </div>
        </article>
      </div>
    </section>
  </main>
  <ContactFooter />
</Base>
