---
import PageHead from '../../layouts/PageHead.astro';
import Header from '../../components/Header.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const fmtDate = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<PageHead lang="en" title={`${data.title} — Blog`} description={data.excerpt} themeDefault="gallery">
  <Header />
  <main id="top">
    <section id="blog-post">
      <div class="wrap">
        <nav class="section-head">
          <a href="/" class="section-link">Home</a>
          <span class="rule"></span>
          <a href="/blog" class="section-link">Blog</a>
          <span class="rule"></span>
          <span class="mono code">{data.title}</span>
        </nav>

        <article>
          <div class="blog-post-meta mono">
            <span class="blog-post-category">{data.category}</span>
            <span>{fmtDate(data.published_date)}</span>
            <span>{data.read_time} min read</span>
          </div>
          <h1 class="blog-post-title">{data.title}</h1>
          <div class="blog-post-tags mono">
            {data.tags.map((tag: string) => (
              <span>{tag}</span>
            ))}
          </div>

          <div class="proj-content prose">
            <Content />
          </div>

          <div class="proj-back">
            <a href="/blog" class="arrow-link"><i>→</i><b>All Posts</b></a>
          </div>
        </article>
      </div>
    </section>
  </main>
  <ContactFooter />
</PageHead>
