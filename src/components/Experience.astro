---
import SectionHead from './SectionHead.astro';
import { getExperience } from '../lib/content';

const experience = await getExperience();
---

<section id="journey">
  <div class="wrap">
    <SectionHead tag="03" title="Experience" code="//career" />
    <div data-reveal>
      {experience.map((xp) => (
        <div class={`xp-row${xp.now ? ' now' : ''}`}>
          <span class="period">{xp.period}</span>
          <div>
            <h3>{xp.title}</h3>
            <span class="co">{xp.company}</span>
            <span class="loc">{xp.location}</span>
          </div>
          <p>{xp.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>
