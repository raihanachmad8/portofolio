---
import SectionHead from './SectionHead.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .sort((a, b) => new Date(b.data.published_date).getTime() - new Date(a.data.published_date).getTime())
  .filter(p => p.data.featured)
  .slice(0, 4);

function fmtDate(d: string) {
  const dt = new Date(d);
  return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<section id="blog">
  <div class="wrap">
    <SectionHead tag="05" title="Blog" code="//writing" />
    <div class="blog-grid">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="blog-card" data-reveal>
          <div class="blog-card-top mono">
            <span>{post.data.category}</span>
            <span>{fmtDate(post.data.published_date)}</span>
          </div>
          <h3>{post.title}</h3>
          <p>{post.data.excerpt}</p>
          <div class="blog-card-meta mono">
            <span>{post.data.read_time} min read</span>
            <span class="arrow-link">Read →</span>
          </div>
        </a>
      ))}
    </div>
    <div class="section-more" data-reveal>
      <a href="/blog" class="view-more-link mono">View All Posts <i>→</i></a>
    </div>
  </div>
</section>
