---
import { getRecentPosts } from '../lib/content';

const posts = await getRecentPosts(3);
---

<section id="blog" class="py-20">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-bold mb-8" style="color: var(--fg);">
      Latest Articles
    </h2>

    {posts.length === 0 ? (
      <div class="text-center py-12" style="color: var(--fg); opacity: 0.5;">
        <p>No articles yet.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map(post => (
          <a
            href={`/blog/${post.slug}`}
            class="blog-card p-6 rounded-lg block transition-transform hover:-translate-y-1"
            style={`background: var(--card-bg); border: 1px solid var(--card-border);`}
          >
            <div class="text-sm mb-2" style="color: var(--acc);">
              {post.category}
            </div>

            <h3 class="text-lg font-bold mb-2" style="color: var(--fg);">
              {post.title}
            </h3>

            <p class="text-sm mb-4 opacity-70" style="color: var(--fg);">
              {post.excerpt}
            </p>

            <div class="flex justify-between text-xs opacity-50" style="color: var(--fg);">
              <span>{post.published_date}</span>
              <span>{post.read_time} min read</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</section>
