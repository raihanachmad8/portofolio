---
import SectionHead from './SectionHead.astro';
import { getAllPosts } from '../lib/content';
import { formatDate, getRuntimeEnv, FEATURED_POST_LIMIT } from '../lib/utils';
import { getLocale } from '@i18n';
import type { Blog } from '@lib/schemas';

const env = getRuntimeEnv(Astro);
let allPosts: Blog[] = [];
try {
  allPosts = await getAllPosts(env);
} catch (e) {
  console.warn('[Blog] Failed to fetch posts:', (e as Error).message);
  allPosts = [];
}
const posts = allPosts
  .filter(p => p.featured)
  .slice(0, FEATURED_POST_LIMIT);

const { t } = getLocale(Astro);
---

<section id="blog">
  <div class="wrap">
    <SectionHead tag="05" title={t('blog.title')} code={t('blog.code')} />
    <div class="blog-grid">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="blog-card" data-reveal>
          <div class="blog-card-top mono">
            <span>{post.category}</span>
            <span>{formatDate(post.published_date)}</span>
          </div>
          <h3>{post.title}</h3>
          <p>{post.excerpt}</p>
          <div class="blog-card-meta mono">
            <span>{post.read_time} {t('blog.minRead')}</span>
            <span class="arrow-link">{t('blog.readMore')} →</span>
          </div>
        </a>
      ))}
    </div>
    <div class="section-more" data-reveal>
      <a href="/blog" class="view-more-link mono">{t('blog.viewAll')} <i>→</i></a>
    </div>
  </div>
</section>
