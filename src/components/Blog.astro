---
import SectionHead from './SectionHead.astro';
import { getAllPosts } from '../lib/content';
import { fmtDate, getRuntimeEnv } from '../lib/utils';

const env = getRuntimeEnv(Astro);
const allPosts = await getAllPosts(env);
const posts = allPosts
  .filter(p => p.featured)
  .slice(0, 4);
---

<section id="blog">
  <div class="wrap">
    <SectionHead tag="05" title="Blog" code="//writing" />
    <div class="blog-grid">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="blog-card" data-reveal>
          <div class="blog-card-top mono">
            <span>{post.category}</span>
            <span>{fmtDate(post.published_date)}</span>
          </div>
          <h3>{post.title}</h3>
          <p>{post.excerpt}</p>
          <div class="blog-card-meta mono">
            <span>{post.read_time} min read</span>
            <span class="arrow-link">Read →</span>
          </div>
        </a>
      ))}
    </div>
    <div class="section-more" data-reveal>
      <a href="/blog" class="view-more-link mono">View All Posts <i>→</i></a>
    </div>
  </div>
</section>
