---
import type { Profile } from '../lib/schemas';
import { getProfile } from '../lib/content';
import { getRuntimeEnv } from '../lib/utils';
import { getLocale } from '@i18n';

interface Props {
  profile?: Profile;
}

const { profile: propProfile } = Astro.props;
const env = getRuntimeEnv(Astro);
// Pages that already fetch profile pass it as a prop (avoids a second fetch);
// otherwise ContactFooter fetches its own so every page gets a complete footer.
const profile = propProfile ?? (await getProfile(env));

const name = profile?.name ?? '';
const email = profile?.email ?? '';
const github = profile?.github ?? '';
const linkedin = profile?.linkedin ?? '';
const cv_url = profile?.cv_url ?? '#';
const location = profile?.location ?? '';

const { t } = getLocale(Astro);
---

<section class="contact" id="contact">
  <div class="wrap">
    <h2 class="contact-title">{t('contact.title')}</h2>
    <a href={`mailto:${email}`} class="email-link">{email} ↗</a>
    <div class="socials delay-2" data-reveal>
      <a href={github} target="_blank" rel="noopener">{t('common.github')} ↗</a>
      <a href={linkedin} target="_blank" rel="noopener">{t('common.linkedin')} ↗</a>
      <a href={cv_url} target="_blank" rel="noopener">{t('common.cv')} ↗</a>
    </div>
    <div class="c-foot">
      <span>© <span id="year">{new Date().getFullYear()}</span> {name}</span>
      <span>{location} · <span class="time">--:--</span></span>
    </div>
  </div>
</section>
