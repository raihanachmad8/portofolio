---
import SectionHead from './SectionHead.astro';
import { getAllProjects } from '../lib/content';
import { resolveImageUrl } from '../lib/config';
import { getRuntimeEnv } from '../lib/utils';
import { createTranslator, detectLocale } from '@i18n';

const env = getRuntimeEnv(Astro);
const siteUrl = env?.PUBLIC_SITE_URL;
const allProjects = await getAllProjects(env);
const projects = allProjects.filter(p => p.featured);

const locale = detectLocale(Astro.request.headers.get('cookie'), Astro.url);
const t = createTranslator(locale);
---

<section id="work">
  <div class="wrap">
    <SectionHead tag="01" title={t('sections.works.title')} code={t('sections.works.code')} />
    <div class="works-grid">
      <aside class="works-side">
        <p>{t('sections.works.description')}</p>
        <nav class="works-index" aria-label="Project navigation">
          {projects.map((pr) => (
            <a href={`#project-${pr.order}`}><i>/{String(pr.order).padStart(2, '0')}</i><b>{pr.title}</b></a>
          ))}
        </nav>
        <a href="/projects" class="view-more-link mono">{t('sections.works.viewAll')} <i>→</i></a>
      </aside>
      <div>
        {projects.map((pr) => (
          <article class="proj" id={`project-${pr.order}`} data-reveal>
            <div class="proj-top mono"><span class="no">/{String(pr.order).padStart(2, '0')}</span><span>{pr.year} · {pr.category}</span></div>
            <figure data-case={pr.order}>
              <img src={resolveImageUrl(pr.image_url, siteUrl)} alt={pr.title} loading="lazy" />
            </figure>
            <h3>{pr.title}</h3>
            <p class="desc">{pr.description}</p>
            <div class="tags">
              {pr.stack.split(',').map((tech: string) => <span>{tech.trim()}</span>)}
            </div>
            <a href={`/projects/${pr.slug}`} class="arrow-link">{t('sections.works.viewCase')}<i>→</i></a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
