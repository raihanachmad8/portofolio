---
import SectionHead from './SectionHead.astro';
import { getAllProjects } from '../lib/content';

const projects = await getAllProjects();
---

<section id="work">
  <div class="wrap">
    <SectionHead tag="01" title="Featured Work" code="//projects" />
    <div class="works-grid">
      <aside class="works-side">
        <p>A selection of projects I've built, from backend systems to full-stack applications.</p>
        <nav class="works-index" aria-label="Project navigation">
          {projects.map((pr) => (
            <a href={`#project-${pr.id}`}><i>/{pr.id}</i><b>{pr.title}</b></a>
          ))}
        </nav>
        <p class="mono" style="margin-top:2rem;color:var(--acc);font-weight:700">Ask Aruna for case studies</p>
      </aside>
      <div>
        {projects.map((pr) => (
          <article class="proj" id={`project-${pr.id}`} data-reveal>
            <div class="proj-top mono"><span class="no">/{pr.id}</span><span>{pr.year} · {pr.category}</span></div>
            <figure data-case={pr.id}><img src={pr.image_url || '/images/placeholder.jpg'} alt={pr.title} loading="lazy" /></figure>
            <h3>{pr.title}</h3>
            <p class="desc">{pr.description}</p>
            <div class="tags">
              {pr.stack.split(',').map((t) => <span>{t.trim()}</span>)}
            </div>
            <button class="arrow-link" data-case={pr.id}>View Case Study<i>→</i></button>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
