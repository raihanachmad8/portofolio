---
import { getFeaturedProjects } from '../lib/content';

const projects = await getFeaturedProjects();
---

<section id="works" class="py-20">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-bold mb-8" style="color: var(--fg);">
      Featured Work
    </h2>

    {projects.length === 0 ? (
      <div class="text-center py-12" style="color: var(--fg); opacity: 0.5;">
        <p>No projects featured yet.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map(project => (
          <a
            href={`/projects/${project.slug}`}
            class="project-card p-6 rounded-lg block transition-transform hover:-translate-y-1"
            style={`background: var(--card-bg); border: 1px solid var(--card-border);`}
          >
            {project.image_url && (
              <img
                src={project.image_url}
                alt={project.title}
                class="w-full h-48 object-cover rounded mb-4"
                loading="lazy"
              />
            )}

            <h3 class="text-xl font-bold mb-2" style="color: var(--fg);">
              {project.title}
            </h3>

            <p class="text-sm mb-4 opacity-70" style="color: var(--fg);">
              {project.description}
            </p>

            <div class="flex flex-wrap gap-2">
              {project.stack.split(',').map(tech => (
                <span
                  class="text-xs px-2 py-1 rounded"
                  style={`background: var(--acc); color: var(--bg);`}
                >
                  {tech.trim()}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</section>
