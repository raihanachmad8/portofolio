---
interface Props {
  name: string;
  tagline: string;
  subtitle?: string;
  location?: string;
  marquee?: string[];
  cvUrl?: string;
}

const { name, tagline, subtitle, location = '', marquee = [], cvUrl = '#' } = Astro.props;
const [name1, name2] = name.split(' ');
---

<section class="hero" id="hero">
  <div class="wrap hero-grid">
    <div>
      <pre id="boot" aria-hidden="true"></pre>
      <h1>
        <span class="mask"><span class="d-1">{name1.toUpperCase()}</span></span>
        <span class="mask"><span class="d-4"><span class="outl">{name2.toUpperCase()}</span></span></span>
      </h1>
      <p class="role-line scr" data-text={tagline}>{tagline}</p>
      <p class="hero-sub d-8" data-reveal>{subtitle}</p>
      <div class="hero-cta d-10" data-reveal>
        <a href="#work" class="btn solid">View Work</a>
        <a href={cvUrl} target="_blank" class="btn ghost">Download CV</a>
        <a href="#contact" class="btn line">Contact</a>
      </div>
    </div>
    <div class="hud d-6" data-reveal>
      <div class="hud-img"><img src="/images/profile.jpg" alt="Profile" /></div>
      <div class="hud-row"><span class="k">LOCATION</span><span class="v">{location}</span></div>
      <div class="hud-row"><span class="k">TIME</span><span class="v time">--:--:--</span></div>
      <div class="hud-row"><span class="k">STATUS</span><span class="v acc"><span class="dot"></span>Available</span></div>
      <div class="hud-row"><span class="k">MODE</span><span class="v">Fullstack Engineering</span></div>
    </div>
  </div>
  <div class="scroll-hint mono"><span class="line"></span>Scroll</div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="mq-track">
    {marquee.map((item) => <span>{item}</span>)}
    {marquee.map((item) => <span>{item}</span>)}
  </div>
</div>
