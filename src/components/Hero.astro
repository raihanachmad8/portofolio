---
interface Props {
  name: string;
  tagline: string;
  subtitle?: string;
}

const { name, tagline, subtitle } = Astro.props;
---

<section id="hero" class="min-h-screen flex items-center justify-center">
  <div class="container mx-auto px-4 text-center">
    <h1 class="text-4xl md:text-6xl font-bold mb-4" style="color: var(--fg);">
      {name}
    </h1>
    <p class="text-xl md:text-2xl mb-2" style="color: var(--acc);">
      {tagline}
    </p>
    {subtitle && (
      <p class="text-lg opacity-70" style="color: var(--fg);">
        {subtitle}
      </p>
    )}

    <div class="mt-8 flex gap-4 justify-center">
      <a href="#works" class="px-6 py-3 rounded" style="background: var(--acc); color: var(--bg);">
        View Work
      </a>
      <a href="#contact" class="px-6 py-3 rounded border" style="border-color: var(--fg); color: var(--fg);">
        Contact
      </a>
    </div>
  </div>
</section>
