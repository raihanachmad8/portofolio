---
import { getLocale } from '@i18n';
import { PROFILE_IMAGE } from '@lib/utils';

interface Props {
  name: string;
  tagline: string;
  subtitle?: string;
  location?: string;
  marquee?: string[];
  cvUrl?: string;
}

const { name, tagline, subtitle, location = '', marquee = [], cvUrl = '#' } = Astro.props;
const nameParts = name?.split(' ') || [];
const name1 = nameParts[0] || '';
const name2 = nameParts.slice(1).join(' ') || '';
const { t } = getLocale(Astro);
---

<section class="hero" id="hero">
  <div class="wrap hero-grid">
    <div>
      <pre id="boot" aria-hidden="true"></pre>
      <h1>
        <span class="mask"><span class="delay-1">{name1.toUpperCase()}</span></span>
        <span class="mask"><span class="delay-4"><span class="name-outline">{name2.toUpperCase()}</span></span></span>
      </h1>
      <p class="role-line scroll" data-text={tagline}>{tagline}</p>
      <p class="hero-sub delay-8" data-reveal>{subtitle}</p>
      <div class="hero-cta delay-10" data-reveal>
        <a href="/#work" class="btn solid">{t('hero.viewWork')}</a>
        <a href={cvUrl} target="_blank" class="btn ghost">{t('hero.downloadCV')}</a>
        <a href="/#contact" class="btn line">{t('hero.contact')}</a>
      </div>
    </div>
    <div class="hud delay-6" data-reveal>
      <div class="hud-img"><img src={PROFILE_IMAGE} alt="Profile" /></div>
      <div class="hud-row"><span class="hud-key">{t('hero.location')}</span><span class="hud-value">{location}</span></div>
      <div class="hud-row"><span class="hud-key">{t('hero.time')}</span><span class="hud-value time">--:--:--</span></div>
      <div class="hud-row"><span class="hud-key">{t('hero.status')}</span><span class="hud-value acc"><span class="dot"></span>{t('hero.available')}</span></div>
      <div class="hud-row"><span class="hud-key">{t('hero.mode')}</span><span class="hud-value">{t('hero.fullstack')}</span></div>
    </div>
  </div>
  <div class="scroll-hint mono"><span class="line"></span>{t('hero.scroll')}</div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="mq-track">
    {marquee.map((item) => <span>{item}</span>)}
    {marquee.map((item) => <span>{item}</span>)}
  </div>
</div>
