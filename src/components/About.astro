---
import SectionHead from './SectionHead.astro';
import { getProfile } from '../lib/content';

const profile = await getProfile();
---

<section id="about">
  <div class="wrap">
    <SectionHead tag="04" title="About" code="//me" />
    <div class="about-grid">
      <div class="about-txt">
        <p class="lead" data-reveal>{profile.aboutLead}</p>
        {profile.aboutParas?.map((par: string, i: number) => (
          <p data-reveal style={`--d:${0.08 + i * 0.06}s`}>{par}</p>
        ))}
        <div class="facts" data-reveal style="--d:.2s">
          {profile.facts?.map((f: any) => (
            <div><span class="n">{f.value}{f.suffix}</span><span class="l">{f.label}</span></div>
          ))}
        </div>
        <ul class="principles" data-reveal style="--d:.26s">
          {profile.principles?.map((pr: any) => (
            <li><i>// {pr.no}</i><b>{pr.title}</b><span>{pr.description}</span></li>
          ))}
        </ul>
      </div>
      <div data-reveal style="--d:.15s">
        <div class="about-ph"><img src="/images/profile.jpg" alt="Profile" loading="lazy" /></div>
        <p class="about-photo-cap"><span>Fig. 01</span><span>{profile.location}</span></p>
      </div>
    </div>
  </div>
</section>
