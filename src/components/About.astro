---
import { getSettings } from '../lib/content';

const settings = await getSettings();
---

<section id="about" class="py-20">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-bold mb-8" style="color: var(--fg);">
      About
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <p class="text-lg mb-6" style="color: var(--fg);">
          Backend engineer passionate about building scalable systems and beautiful experiences.
        </p>
        <p class="mb-6 opacity-70" style="color: var(--fg);">
          I specialize in building robust backend systems, APIs, and infrastructure that power modern web applications.
        </p>

        <div class="flex gap-4">
          {settings.github_url && (
            <a
              href={settings.github_url}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded text-sm"
              style="background: var(--acc); color: var(--bg);"
            >
              GitHub
            </a>
          )}
          {settings.linkedin_url && (
            <a
              href={settings.linkedin_url}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded text-sm"
              style="border: 1px solid var(--fg); color: var(--fg);"
            >
              LinkedIn
            </a>
          )}
        </div>
      </div>

      <div class="p-6 rounded-lg" style="background: var(--card-bg); border: 1px solid var(--card-border);">
        <h3 class="text-lg font-bold mb-4" style="color: var(--acc);">
          Quick Facts
        </h3>
        <ul class="space-y-2" style="color: var(--fg);">
          <li class="flex justify-between">
            <span class="opacity-70">Location</span>
            <span>Indonesia</span>
          </li>
          <li class="flex justify-between">
            <span class="opacity-70">Focus</span>
            <span>Backend Engineering</span>
          </li>
          <li class="flex justify-between">
            <span class="opacity-70">Available</span>
            <span style="color: var(--acc);">Yes</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
