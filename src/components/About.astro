---
import SectionHead from './SectionHead.astro';
import type { Profile } from '../lib/schemas';

interface Props {
  profile?: Profile;
}

const { profile } = Astro.props;
if (!profile) return null;
---

<section id="about">
  <div class="wrap">
    <SectionHead tag="02" title="About" code="//me" />
    <div class="about-grid">
      <div class="about-txt">
        <p class="lead" data-reveal>{profile.aboutLead}</p>
        {profile.aboutParas?.map((par: string, i: number) => (
          <p data-reveal class={`d-${i + 2}`}>{par}</p>
        ))}
        <div class="facts d-4" data-reveal>
          {profile.facts?.map((f: any) => (
            <div><span class="n">{f.value}</span><span class="l">{f.label}</span></div>
          ))}
        </div>
        <ul class="principles d-5" data-reveal>
          {profile.principles?.map((pr: any) => (
            <li><i>// {pr.no}</i><b>{pr.title}</b><span>{pr.description}</span></li>
          ))}
        </ul>
      </div>
      <div class="d-3" data-reveal>
        <div class="about-ph"><img src="/images/profile-formal.jpg" alt={profile.name} loading="lazy" /></div>
        <p class="about-photo-cap"><span>Fig. 01</span><span>{profile.location}</span></p>
      </div>
    </div>
  </div>
</section>
