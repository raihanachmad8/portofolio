---
import SectionHead from './SectionHead.astro';
import type { Profile } from '../lib/schemas';
import { getLocale } from '@i18n';
import { PROFILE_FORMAL_IMAGE } from '@lib/utils';

interface Props {
  profile?: Profile;
}

const { profile } = Astro.props;
if (!profile) return null;

const { t } = getLocale(Astro);
---

<section id="about">
  <div class="wrap">
    <SectionHead tag="02" title={t('sections.about.title')} code={t('sections.about.code')} />
    <div class="about-grid">
      <div class="about-txt">
        <p class="lead" data-reveal>{profile.aboutLead}</p>
        {profile.aboutParas?.map((par: string, i: number) => (
          <p data-reveal class={`delay-${i + 2}`}>{par}</p>
        ))}
        <div class="facts delay-4" data-reveal>
          {profile.facts?.map((f: { value: number; label: string }) => (
            <div><span class="fact-value">{f.value}</span><span class="fact-label">{f.label}</span></div>
          ))}
        </div>
        <ul class="principles delay-5" data-reveal>
          {profile.principles?.map((pr: { no: string; title: string; description: string }) => (
            <li><i>// {pr.no}</i><b>{pr.title}</b><span>{pr.description}</span></li>
          ))}
        </ul>
      </div>
      <div class="delay-3" data-reveal>
        <div class="about-ph"><img src={PROFILE_FORMAL_IMAGE} alt={profile.name} loading="lazy" /></div>
        <p class="about-photo-cap"><span>Fig. 01</span><span>{profile.location}</span></p>
      </div>
    </div>
  </div>
</section>
