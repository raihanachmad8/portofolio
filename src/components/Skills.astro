---
import SectionHead from './SectionHead.astro';
import { getSkillsByCategory } from '../lib/content';

const skills = await getSkillsByCategory();
---

<section id="skills">
  <div class="wrap">
    <SectionHead tag="02" title="Skills" code="//tech" />
    <div class="skills-grid">
      <div class="skill-col" data-reveal>
        <h3>&gt; Backend (Core)</h3>
        {skills.backend?.map((sk: any) => (
          <div class="sk">
            <div class="row"><span>{sk.name}</span><span>{sk.level}%</span></div>
            <div class="sb"><span data-lv={`${sk.level}%`}></span></div>
          </div>
        ))}
        <div class="tools">{skills.tools?.backend?.map((t: string) => <i>{t}</i>)}</div>
      </div>
      <div class="skill-col" data-reveal style="--d:.1s">
        <h3>&gt; Frontend</h3>
        {skills.frontend?.map((sk: any) => (
          <div class="sk">
            <div class="row"><span>{sk.name}</span><span>{sk.level}%</span></div>
            <div class="sb"><span data-lv={`${sk.level}%`}></span></div>
          </div>
        ))}
        <div class="tools">{skills.tools?.frontend?.map((t: string) => <i>{t}</i>)}</div>
      </div>
      <div class="skill-col" data-reveal style="--d:.2s">
        <h3>&gt; DevOps &amp; Database</h3>
        {skills.devops?.map((sk: any) => (
          <div class="sk">
            <div class="row"><span>{sk.name}</span><span>{sk.level}%</span></div>
            <div class="sb"><span data-lv={`${sk.level}%`}></span></div>
          </div>
        ))}
        <div class="tools">{skills.tools?.devops?.map((t: string) => <i>{t}</i>)}</div>
      </div>
    </div>
    <p class="sk-note" data-reveal><b>Database</b> — PostgreSQL · MongoDB · Redis · Prisma · Drizzle &nbsp;✳&nbsp; <b>Soft Skills</b> — Communication · Teamwork · Problem Solving</p>
  </div>
</section>
