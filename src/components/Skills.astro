---
import SectionHead from './SectionHead.astro';
import { getSkillsByCategory } from '../lib/content';
import { getRuntimeEnv } from '../lib/utils';
import { createTranslator, detectLocale } from '@i18n';

const env = getRuntimeEnv(Astro);
const skills = await getSkillsByCategory(env);
const locale = detectLocale(Astro.request.headers.get('cookie'), Astro.url);
const t = createTranslator(locale);
---

<section id="skills">
  <div class="wrap">
    <SectionHead tag="03" title={t('sections.skills.title')} code={t('sections.skills.code')} />
    <div class="skills-grid">
      <div class="skill-col" data-reveal>
        <h3>&gt; Backend (Core)</h3>
        {skills.backend?.map((sk: any) => (
          <div class="sk">
            <div class="row"><span>{sk.name}</span><span>{sk.level}%</span></div>
            <div class="sb"><span data-lv={`${sk.level}%`}></span></div>
          </div>
        ))}
        <div class="tools">{skills.tools?.backend?.map((t: string) => <i>{t}</i>)}</div>
      </div>
      <div class="skill-col d-2" data-reveal>
        <h3>&gt; Frontend</h3>
        {skills.frontend?.map((sk: any) => (
          <div class="sk">
            <div class="row"><span>{sk.name}</span><span>{sk.level}%</span></div>
            <div class="sb"><span data-lv={`${sk.level}%`}></span></div>
          </div>
        ))}
        <div class="tools">{skills.tools?.frontend?.map((t: string) => <i>{t}</i>)}</div>
      </div>
      <div class="skill-col d-4" data-reveal>
        <h3>&gt; DevOps &amp; Database</h3>
        {skills.devops?.map((sk: any) => (
          <div class="sk">
            <div class="row"><span>{sk.name}</span><span>{sk.level}%</span></div>
            <div class="sb"><span data-lv={`${sk.level}%`}></span></div>
          </div>
        ))}
        <div class="tools">{skills.tools?.devops?.map((t: string) => <i>{t}</i>)}</div>
      </div>
    </div>
  </div>
</section>
