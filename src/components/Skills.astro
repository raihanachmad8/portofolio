---
import { getSkillsByCategory } from '../lib/content';

const skillsByCategory = await getSkillsByCategory();
const categories = Object.keys(skillsByCategory);
---

<section id="skills" class="py-20">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-bold mb-8" style="color: var(--fg);">
      Skills
    </h2>

    {categories.length === 0 ? (
      <div class="text-center py-12" style="color: var(--fg); opacity: 0.5;">
        <p>No skills added yet.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map(category => (
          <div class="p-6 rounded-lg" style="background: var(--card-bg); border: 1px solid var(--card-border);">
            <h3 class="text-lg font-semibold mb-4 capitalize" style="color: var(--acc);">
              {category}
            </h3>

            <div class="space-y-4">
              {skillsByCategory[category].map(skill => (
                <div class="skill-bar">
                  <div class="flex justify-between mb-1">
                    <span class="text-sm" style="color: var(--fg);">{skill.title}</span>
                    <span class="text-xs opacity-70" style="color: var(--fg);">
                      {skill.level}/5
                    </span>
                  </div>

                  <div class="h-2 rounded-full" style="background: var(--card-border);">
                    <div
                      class="h-full rounded-full transition-all duration-500"
                      style={`width: ${skill.level * 20}%; background: var(--acc);`}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
