---
import '../styles/global.css';
import '../styles/themes/terminal.css';
import '../styles/themes/editorial.css';
import '../styles/themes/gallery.css';
import '../styles/themes/swiss.css';
import ArunaChat from '../components/aruna/ArunaChat.astro';
// NOTE: DEFAULT_THEME constant ('gallery') exists in @lib/utils but cannot be
// referenced here because this is an inline script running in the browser.

interface Props {
  lang: string;
  title: string;
  themeDefault: string;
}

const { lang, title, themeDefault } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme={themeDefault}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;600;700&family=Space+Mono:wght@400;700&family=Fraunces:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Sora:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;700&family=Instrument+Serif:ital@0;1&family=Instrument+Sans:wght@400;500;600;700&family=Fragment+Mono:wght@400&family=Syne:wght@400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      (function() {
        var urlTheme = new URLSearchParams(window.location.search).get('theme');
        var savedTheme = localStorage.getItem('theme');
        var theme = urlTheme || savedTheme || 'gallery';
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        window.__THEME_APPLIED__ = theme;
      })();
    </script>
  </head>
  <body>
    <div class="bg-grid" aria-hidden="true"></div>
    {import.meta.env.PUBLIC_DEBUG_MODE === 'true' && (
      <div class="debug-label">
        <span class="debug-source">{(import.meta.env.PUBLIC_DATA_SOURCE || 'local').toUpperCase()}</span>
        <span class="debug-info">Debug Mode Active</span>
      </div>
    )}
    <slot />
    <ArunaChat />
    <script is:inline src="/scripts/theme.js"></script>
    <script is:inline src="/scripts/mermaid.js"></script>
    <script is:inline src="/scripts/ui.js"></script>
  </body>
</html>
