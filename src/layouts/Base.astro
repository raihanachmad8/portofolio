---
import '../styles/global.css';
import '../styles/themes/terminal.css';
import '../styles/themes/editorial.css';
import '../styles/themes/gallery.css';
import '../styles/themes/swiss.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<script is:inline>
  (function() {
    const urlParams = new URLSearchParams(window.location.search);
    const urlTheme = urlParams.get('theme');
    const savedTheme = localStorage.getItem('theme');
    
    fetch('/config.json')
      .then(r => r.json())
      .then(config => {
        const theme = urlTheme || savedTheme || config.theme || 'terminal';
        applyTheme(theme);
        
        if (config.sections) {
          Object.entries(config.sections).forEach(([section, theme]) => {
            const el = document.getElementById(section);
            if (el) el.dataset.theme = theme;
          });
        }
      })
      .catch(() => {
        applyTheme(urlTheme || savedTheme || 'terminal');
      });

    function applyTheme(theme) {
      document.documentElement.dataset.theme = theme;
      localStorage.setItem('theme', theme);
    }

    window.switchTheme = function(theme) {
      applyTheme(theme);
    };
  })();
</script>
