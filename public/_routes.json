{
  "version": 1,
  "description": "Cloudflare Pages routing - exclude static assets from SSR",
  "include": ["/*"],
  "exclude": [
    "/images/*",
    "/scripts/*",
    "/document/*",
    "/favicon.svg",
    "/robots.txt",
    "/mermaid.min.js",
    "/*.svg",
    "/*.png",
    "/*.jpg",
    "/*.jpeg",
    "/*.webp",
    "/*.ico",
    "/*.pdf",
    "/*.js",
    "/*.css",
    "/*.woff",
    "/*.woff2",
    "/*.ttf",
    "/*.xml",
    "/*.txt",
    "/_astro/*"
  ]
}
